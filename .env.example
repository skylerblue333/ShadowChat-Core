# Public application configuration
VITE_APP_ID=replace-with-public-app-id
VITE_OAUTH_PORTAL_URL=https://your-oauth-provider.example
OAUTH_SERVER_URL=https://your-oauth-provider.example

# Server-only secrets and persistence
JWT_SECRET=replace-with-a-long-random-server-secret
DATABASE_URL=mysql://user:password@host:3306/database

# Optional owner notification configuration
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

NODE_ENV=production
